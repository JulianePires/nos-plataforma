{
  "name": "nos-plataforma",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:types": "bun scripts/db-types.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "10.14.0",
    "prettier": "3.9.6",
    "supabase": "3.1.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
