# Copie para .env.local e preencha. Nunca versione o .env.local.
# Este arquivo é versionado: só marcadores, nunca valores reais.

# MCP do Supabase (nos-prod, só leitura; o dev é o banco local, ADR 0009)
SUPABASE_PROD_PROJECT_REF="your-project-ref"

CONTEXT7_API_KEY="your-api-key"

# MCP do GitHub (token fine-grained, só este repositório)
GITHUB_PAT="github_pat_xxxxxxxxxxxx"

# Supabase — lidas pelo app e validadas em apps/web/lib/env.ts (o app não sobe sem elas).
# Banco local: URL "http://127.0.0.1:54321" e a anon key de `bunx supabase status`.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — ainda não lidas pelo app (ADR 0004): entram só quando um card precisar.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# Server-only: ignoram RLS. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Supabase — Postgres (Dashboard > Connect)
SUPABASE_POSTGRES_HOST="db.your-project-ref.supabase.co"
SUPABASE_POSTGRES_DATABASE="postgres"
SUPABASE_POSTGRES_USER="postgres"
SUPABASE_POSTGRES_PASSWORD="your-db-password"
SUPABASE_POSTGRES_URL="postgres://postgres.your-project-ref:your-db-password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
SUPABASE_POSTGRES_PRISMA_URL="postgres://postgres.your-project-ref:your-db-password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
SUPABASE_POSTGRES_URL_NON_POOLING="postgres://postgres.your-project-ref:your-db-password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
