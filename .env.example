# Copie para .env.local e preencha. Nunca versione o .env.local.
# Este arquivo é versionado: só marcadores, nunca valores reais.

# MCP do Supabase (projeto de desenvolvimento, só leitura)
SUPABASE_DEV_PROJECT_REF="your-project-ref"

CONTEXT7_API_KEY="your-api-key"

# MCP do GitHub (token fine-grained, só este repositório)
GITHUB_PAT="github_pat_xxxxxxxxxxxx"

# Supabase — API (Dashboard > Project Settings > API)
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only: ignoram RLS. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Supabase — Postgres (Dashboard > Connect)
SUPABASE_POSTGRES_HOST="db.your-project-ref.supabase.co"
SUPABASE_POSTGRES_DATABASE="postgres"
SUPABASE_POSTGRES_USER="postgres"
SUPABASE_POSTGRES_PASSWORD="your-db-password"
SUPABASE_POSTGRES_URL="postgres://postgres.your-project-ref:your-db-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
SUPABASE_POSTGRES_PRISMA_URL="postgres://postgres.your-project-ref:your-db-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
SUPABASE_POSTGRES_URL_NON_POOLING="postgres://postgres.your-project-ref:your-db-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
